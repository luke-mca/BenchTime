# Copy this file to server/.env and fill in the values.

# Port the API server listens on. The client's dev proxy expects 3000.
PORT=3000

# development or test or production. 
NODE_ENV=development

# The PostgreSQL connection string.
DATABASE_URL=postgres://postgres:[PASSWORD]@localhost:5432/benchtime

# Secrets used to sign JWTs. Use two different long random strings, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=CHANGE_ME
REFRESH_TOKEN_SECRET=CHANGE_ME_TOO

# URL the web client is served from.
CLIENT_ORIGIN=http://localhost:5173
